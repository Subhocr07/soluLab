PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL connection (production / development)
DATABASE_URL=postgresql://postgres:password@localhost:5432/payments_db

# Payment retry config
MAX_RETRIES=3
INITIAL_BACKOFF_MS=1000
MAX_BACKOFF_MS=30000

# Gateway simulation config
GATEWAY_SUCCESS_RATE=0.7
GATEWAY_MIN_DELAY_MS=100
GATEWAY_MAX_DELAY_MS=2000
GATEWAY_TIMEOUT_RATE=0.1
GATEWAY_TIMEOUT_MS=5000

# Circuit breaker config
CB_FAILURE_THRESHOLD=5
CB_SUCCESS_THRESHOLD=2
CB_TIMEOUT_MS=60000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Webhook secret for signature verification
WEBHOOK_SECRET=change-this-in-production
